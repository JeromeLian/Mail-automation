# Copy this file to .env and fill it in. Never commit .env.

# Zoho API client (from api-console.zoho.com, a "Self Client")
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Refresh token, created once by: python scripts/export_zoho_companies.py --exchange-code CODE
ZOHO_REFRESH_TOKEN=

# Region. Singapore accounts use the .com.sg addresses below; otherwise use .com
ZOHO_ACCOUNTS=https://accounts.zoho.com
ZOHO_API=https://www.zohoapis.com
